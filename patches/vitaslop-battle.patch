+
+#[test]
+fn kernel_signals_follow_the_thread_while_a_fiber_is_running() {
+    let mut st = state();
+    st.set_preemptive(true);
+    let runner = st.current;
+    let fiber = 0x8300_0000;
+    assert_eq!(st.fiber_initialize(fiber, "wait".into(), ENTRY, 0, 0, 0), 0);
+    assert_eq!(st.fiber_run(fiber, 0, 0, 0x8100_1234), Ok(()));
+    let context = st.fibers.thid(0);
+    st.set_current(context);
+    st.take_wakes();
+    st.send_signal(runner).unwrap();
+    assert!(st.take_signal(context));
+    assert!(!st.take_signal(context));
+    st.signal_block();
+    st.send_signal(runner).unwrap();
+    assert_eq!(st.take_wakes(), vec![context]);
+    assert!(!st.take_signal(runner));
+}
