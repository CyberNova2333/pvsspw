+// SOFTWARE.
+
+// FSR 1.0, FP32. Integer texel loads keep the twelve EASU taps distinct.
+// The source is the gamma-encoded SDR display stage, before host UI.
+@group(0) @binding(0) var source: texture_2d<f32>;
+
+struct Vertex { @builtin(position) pos: vec4f, @location(0) uv: vec2f };
+@vertex fn fullscreen(@builtin(vertex_index) vertex: u32) -> Vertex {
+    let uv = vec2f(f32((vertex << 1u) & 2u), f32(vertex & 2u));
+    return Vertex(vec4f(uv * vec2f(2, -2) + vec2f(-1, 1), 0, 1), uv);
+}
+fn rgb(p: vec2i) -> vec3f {
+    let last = vec2i(textureDimensions(source)) - vec2i(1);
+    return textureLoad(source, clamp(p, vec2i(0), last), 0).rgb;
+}
+fn luma(c: vec3f) -> f32 { return c.g + 0.5 * (c.r + c.b); }
+
+// Weighted direction and edge strength at one of the four nearest texels.
+fn gradient(w: f32, a: f32, b: f32, c: f32, d: f32, e: f32) -> vec3f {
+    let direction = vec2f(d - b, e - a);
+    let peak = max(abs(vec2f(d, e) - c), abs(vec2f(b, a) - c));
+    let ratio = min(abs(direction) / max(peak, vec2f(1e-8)), vec2f(1));
+    return w * vec3f(direction, dot(ratio, ratio));
+}
+
+const offsets = array<vec2i, 12>(
+    vec2i(0,-1), vec2i(1,-1),
+    vec2i(-1,0), vec2i(0,0), vec2i(1,0), vec2i(2,0),
+    vec2i(-1,1), vec2i(0,1), vec2i(1,1), vec2i(2,1),
+    vec2i(0,2), vec2i(1,2));
+
+@fragment fn easu(in: Vertex) -> @location(0) vec4f {
+    let samplePos = in.uv * vec2f(textureDimensions(source)) - 0.5;
+    let origin = vec2i(floor(samplePos));
+    let f = fract(samplePos);
+    var colors: array<vec3f, 12>;
+    var y: array<f32, 12>;
+    for (var i = 0u; i < 12u; i++) {
+        colors[i] = rgb(origin + offsets[i]);
+        y[i] = luma(colors[i]);
+    }
+    let edge = gradient((1-f.x)*(1-f.y), y[0], y[2], y[3], y[4], y[7])
+             + gradient(f.x*(1-f.y), y[1], y[3], y[4], y[5], y[8])
+             + gradient((1-f.x)*f.y, y[3], y[6], y[7], y[8], y[10])
+             + gradient(f.x*f.y, y[4], y[7], y[8], y[9], y[11]);
+    let magnitude2 = dot(edge.xy, edge.xy);
+    var dir = vec2f(1,0);
+    if (magnitude2 >= 1.0/32768.0) { dir = edge.xy * inverseSqrt(magnitude2); }
+    let strength = 0.25 * edge.z * edge.z;
+    let stretch = dot(dir, dir) / max(abs(dir.x), abs(dir.y));
+    let axes = vec2f(1 + (stretch-1)*strength, 1 - 0.5*strength);
+    let lobe = 0.5 - 0.29*strength;
+    var sum = vec3f(0);
+    var weight = 0.0;
+    for (var i = 0u; i < 12u; i++) {
+        let offset = vec2f(offsets[i]) - f;
+        let rotated = vec2f(dot(offset, dir), dot(offset, vec2f(-dir.y, dir.x))) * axes;
+        let d2 = min(dot(rotated, rotated), 1/lobe);
+        let a = lobe*d2 - 1;
+        let b = 0.4*d2 - 1;
+        let w = (1.5625*b*b - 0.5625)*a*a;
+        sum += w*colors[i];
+        weight += w;
+    }
+    let lo = min(min(colors[3],colors[4]), min(colors[7],colors[8]));
+    let hi = max(max(colors[3],colors[4]), max(colors[7],colors[8]));
+    return vec4f(clamp(sum / max(weight, 1e-8), lo, hi), 1);
+}
+
+@fragment fn rcas(in: Vertex) -> @location(0) vec4f {
+    let p = vec2i(in.pos.xy);
+    let c = rgb(p);
+    let n = rgb(p+vec2i(0,-1)); let s = rgb(p+vec2i(0,1));
+    let e = rgb(p+vec2i(1,0)); let w = rgb(p+vec2i(-1,0));
+    let lo = min(min(n,s), min(e,w));
+    let hi = max(max(n,s), max(e,w));
+    let hitMin = min(lo,c) / max(4*hi, vec3f(1e-8));
+    let hitMax = (1-max(hi,c)) / min(4*lo-4, vec3f(-1e-8));
+    let channel = max(-hitMin, hitMax);
+    // One stop of RCAS attenuation; the peak negative lobe is 3/16.
+    let lobe = 0.5 * clamp(max(max(channel.r,channel.g),channel.b), -0.1875, 0);
+    return vec4f((c + lobe*(n+s+e+w)) / (1+4*lobe), 1);
+}
