new file mode 100644
index 0000000..4070df0
--- /dev/null
+++ b/projects/vitaslop-web/src/fsr1.rs
@@ -0,0 +1,68 @@
+//! Two GPU passes over the final Vita display texture. The scratch image follows
+//! the output dimensions; neither pass changes guest render targets or scheduling.
+pub struct Fsr1 {
+    easu: wgpu::RenderPipeline,
+    rcas: wgpu::RenderPipeline,
+    source: wgpu::BindGroup,
+    scratch: Option<(wgpu::Texture, wgpu::TextureView, wgpu::BindGroup)>,
+}
+
+fn bind(device: &wgpu::Device, pipeline: &wgpu::RenderPipeline, view: &wgpu::TextureView) -> wgpu::BindGroup {
+    device.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: Some("fsr1-input"),
+        layout: &pipeline.get_bind_group_layout(0),
+        entries: &[wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(view) }],
+    })
+}
+
+impl Fsr1 {
+    pub fn new(device: &wgpu::Device, format: wgpu::TextureFormat, source: &wgpu::TextureView) -> Self {
+        let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("FSR 1"), source: wgpu::ShaderSource::Wgsl(include_str!("fsr1.wgsl").into()),
+        });
+        let pipeline = |entry, format| device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+            label: Some(entry), layout: None,
+            vertex: wgpu::VertexState { module: &module, entry_point: Some("fullscreen"), buffers: &[], compilation_options: Default::default() },
+            fragment: Some(wgpu::FragmentState {
+                module: &module, entry_point: Some(entry), compilation_options: Default::default(),
+                targets: &[Some(wgpu::ColorTargetState { format, blend: None, write_mask: wgpu::ColorWrites::ALL })],
+            }),
+            primitive: Default::default(), depth_stencil: None, multisample: Default::default(), multiview_mask: None, cache: None,
+        });
+        let easu = pipeline("easu", wgpu::TextureFormat::Rgba8Unorm);
+        let source = bind(device, &easu, source);
+        Self { easu, rcas: pipeline("rcas", format), source, scratch: None }
+    }
+
+    pub fn encode(&mut self, device: &wgpu::Device, encoder: &mut wgpu::CommandEncoder, target: &wgpu::TextureView, width: u32, height: u32) {
+        if self.scratch.as_ref().is_none_or(|(t, _, _)| (t.width(), t.height()) != (width, height)) {
+            let tex = device.create_texture(&wgpu::TextureDescriptor {
+                label: Some("fsr1-scratch"),
+                size: wgpu::Extent3d { width, height, depth_or_array_layers: 1 },
+                dimension: wgpu::TextureDimension::D2, format: wgpu::TextureFormat::Rgba8Unorm,
+                mip_level_count: 1, sample_count: 1, view_formats: &[],
+                usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::RENDER_ATTACHMENT,
+            });
+            let view = tex.create_view(&Default::default());
+            let input = bind(device, &self.rcas, &view);
+            self.scratch = Some((tex, view, input));
+        }
+        let (_, intermediate, sharp_input) = self.scratch.as_ref().unwrap();
+        for (label, pipeline, input, dst) in [
+            ("fsr1-easu", &self.easu, &self.source, intermediate),
+            ("fsr1-rcas", &self.rcas, sharp_input, target),
+        ] {
+            let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some(label),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: dst, resolve_target: None, depth_slice: None,
+                    ops: wgpu::Operations { load: wgpu::LoadOp::Clear(wgpu::Color::BLACK), store: wgpu::StoreOp::Store },
+                })],
+                depth_stencil_attachment: None, timestamp_writes: None, occlusion_query_set: None, multiview_mask: None,
+            });
+            pass.set_pipeline(pipeline);
+            pass.set_bind_group(0, input, &[]);
+            pass.draw(0..3, 0..1);
+        }
+    }
+}
