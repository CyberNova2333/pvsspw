+// strlcpy/strlcat return the full attempted length, even for a zero-sized or
+// truncated destination. Scan in chunks so long strings need no large allocation.
+fn string_length(ctx: &GuestCtx, addr: u32, limit: u32) -> u32 {
+    let mut offset = 0;
+    while offset < limit {
+        let count = (limit - offset).min(256);
+        let bytes = ctx.read_bytes(addr.wrapping_add(offset), count as usize);
+        let len = bytes.iter().position(|&b| b == 0).unwrap_or(bytes.len()) as u32;
+        offset += len;
+        if len < count { break; }
+    }
+    offset
+}
+
+fn copy_string(ctx: &mut GuestCtx, dst: u32, src: u32, capacity: u32) -> u32 {
+    let len = string_length(ctx, src, u32::MAX);
+    if capacity > 0 {
+        let count = len.min(capacity - 1);
+        let mut offset = 0;
+        while offset < count {
+            let n = (count - offset).min(256);
+            let bytes = ctx.read_bytes(src.wrapping_add(offset), n as usize);
+            ctx.write_bytes(dst.wrapping_add(offset), &bytes);
+            offset += n;
+        }
+        ctx.write_bytes(dst.wrapping_add(count), &[0]);
+    }
+    len
+}
+
+#[hostcall]
+pub(super) fn clib_strlcpy(ctx: &mut GuestCtx, dst: Ptr, src: Ptr, size: u32) -> u32 {
+    copy_string(ctx, dst.addr(), src.addr(), size)
+}
+
+#[hostcall]
+pub(super) fn clib_strlcat(ctx: &mut GuestCtx, dst: Ptr, src: Ptr, size: u32) -> u32 {
+    let used = string_length(ctx, dst.addr(), size);
+    used.wrapping_add(copy_string(ctx, dst.addr().wrapping_add(used), src.addr(), size - used))
+}
