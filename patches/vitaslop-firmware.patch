+// VFP scalar, in-place conversion between f32 and a 32-bit fixed-point S register.
+// ARM and Thumb-2 share this encoding after exchanging the Thumb halfwords.
+// Decode the ordinary scalar conversion for its condition, size and registers,
+// then carry the immediate fractional-bit count into lowering.
+fn scalar_fixed_vcvt(decoder: &InstDecoder, bytes: &[u8], thumb: bool) -> Option<Instruction> {
+    let raw = u32::from_le_bytes(bytes.get(..4)?.try_into().ok()?);
+    let word = if thumb { raw.rotate_left(16) } else { raw };
+    if word & 0x0fba_0fd0 != 0x0eba_0ac0 || word >> 28 == 15 || (thumb && word >> 28 != 14) {
+        return None;
+    }
+    let to_fixed = (word & (1 << 18)) != 0;
+    let signed = (word & (1 << 16)) == 0;
+    let opc = if to_fixed { 12 + u32::from(signed) } else { 8 };
+    let same_register = ((word >> 12) & 15) | (((word >> 22) & 1) << 5);
+    let equivalent = (word & 0xf040_f000) | 0x0eb0_0a40 | (opc << 16)
+        | (u32::from(to_fixed || signed) << 7) | same_register;
+    let encoded = if thumb { equivalent.rotate_left(16) } else { equivalent };
+    let mut instruction = decoder.decode(&mut U8Reader::new(&encoded.to_le_bytes())).ok()?;
+    let imm5 = ((word & 15) << 1) | ((word >> 5) & 1);
+    instruction.operands[2] = Operand::Imm(32 - imm5);
+    Some(instruction)
+}
