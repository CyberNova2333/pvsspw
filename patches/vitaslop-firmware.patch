+#[cfg(test)]
+mod scalar_fixed_tests {
+    use super::*;
+
+    #[test]
+    fn scalar_fixed_in_place_on_arm_and_thumb() {
+        for (word, register, bits, to, from) in [
+            (0xeefe_7ac1u32, 15, 30, VfpType::S32, VfpType::F32),
+            (0xeebf_0aef, 0, 1, VfpType::U32, VfpType::F32),
+            (0xeeba_fac0, 30, 32, VfpType::F32, VfpType::S32),
+            (0xeebb_2aca, 4, 12, VfpType::F32, VfpType::U32),
+        ] {
+            for thumb in [false, true] {
+                let decoder = InstDecoder::default().with_thumb_mode(thumb);
+                let encoded = if thumb {word.rotate_left(16)} else {word};
+                let (ins, len) = decode_at(&decoder, &encoded.to_le_bytes(), 0, 0, thumb).unwrap();
+                assert_eq!(len, 4);
+                assert!(matches!(ins.opcode, Opcode::VCVT{to:t,from:f,..} if t==to && f==from));
+                assert_eq!(s_num(&ins.operands[0]), Some(register));
+                assert_eq!(s_num(&ins.operands[1]), Some(register));
+                assert_eq!(ins.operands[2], Operand::Imm(bits));
+            }
+        }
+    }
+}
