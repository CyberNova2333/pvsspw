+#[derive(Clone, Copy, Default)]
+struct DirectionStep {
+    pending: u8,
+    release: bool,
+    next_repeat_us: Option<u64>,
+}
+
+impl DirectionStep {
+    fn take(&mut self, now_us: u64) -> bool {
+        if self.release {
+            self.release = false;
+            return false;
+        }
+        if self.pending > 0 {
+            self.pending -= 1;
+        } else if self.next_repeat_us.is_some_and(|due| now_us >= due) {
+            // Schedule from this poll so a slow frame cannot build a backlog.
+            self.next_repeat_us = Some(now_us.saturating_add(160_000));
+        } else {
+            return false;
+        }
+        self.release = true;
+        true
+    }
+}
+
+// SceCtrl direction bits in clockwise order: up, right, down, left.
+const DIRECTION_BITS: [u32; 4] = [0x10, 0x20, 0x40, 0x80];
