+#[wasm_bindgen]
+pub fn worker_step_direction(direction: usize) {
+    with_worker_input(|state| {
+        if let Some(step) = state.direction_steps.get_mut(direction) {
+            step.pending = step.pending.saturating_add(1);
+        }
+    });
